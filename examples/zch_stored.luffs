// A first, deliberately small zch decoder: one stored block, no raw tail.
// The current zch wire format starts with u64 little-endian plaintext length,
// then a u16 block prefix. Prefix zero means a stored block.
fn decode_zch_stored(input: &[u8], output: &mut [u8]) -> Option<usize> {
    if input.len() < 10 { return None; }

    let plen64: u64 = (input[0] as u64)
        | ((input[1] as u64) << 8)
        | ((input[2] as u64) << 16)
        | ((input[3] as u64) << 24)
        | ((input[4] as u64) << 32)
        | ((input[5] as u64) << 40)
        | ((input[6] as u64) << 48)
        | ((input[7] as u64) << 56);
    if plen64 > usize::MAX as u64 {
        return None;
    }
    let plen: usize = plen64 as usize;
    if plen == 0 || plen > 32768 || (plen & 127) != 0 {
        return None;
    }
    let prefix: u16 = (input[8] as u16) | ((input[9] as u16) << 8);
    if prefix != 0 {
        return None;
    }

    if input.len() < 10 + plen { return None; }
    if output.len() < plen { return None; }

    // `..+` is a (begin, length) slice. `..<` is a (begin, end) slice.
    let stored: &[u8] = input[10..+plen];
    let dst: &mut [u8] = output[0..<plen];
    dst.copy_from_slice(stored);
    Some(plen)
}

fn main() {
    let input: [u8; 138] = [0; 138];
    let mut output: [u8; 128] = [0; 128];
    let _ = decode_zch_stored(&input, &mut output);
}
