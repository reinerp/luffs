  have hupdate := hencoded.applyAll_update (index := 0) (value := (1 : BitVec 8))
    (before := ([⟨offsetsBase, 8, 0, usizeBytes 0⟩,
      ⟨sizesBase, 8, 0, usizeBytes poolBytes⟩] : List ElementWrite))
