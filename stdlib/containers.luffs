// refines Luffs.Runtime.Containers.vecPushI8
fn vec_push_i8(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: i8) -> Option<usize> {
    if capacity > usize::MAX { return None; }
    if len >= capacity { return None; }
    if offset > usize::MAX - len { return None; }
    if offset + len > usize::MAX - 1 { return None; }
    if offset + len >= storage.len() { return None; }
    storage[offset + len] = (value & 255) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
