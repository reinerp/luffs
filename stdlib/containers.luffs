// Concrete byte-specialized Box and Vec runtime operations. Generic codecs are
// represented in Lean; these functions are the first monomorphized lowering.

// refines Luffs.Runtime.Containers.boxStoreU8
fn box_initialize_u8(storage: &mut [u8], begin: usize, value: u8) -> Option<()> {
    if begin >= storage.len() { return None; }
    storage[begin] = value;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU8
fn box_load_u8(storage: &[u8], begin: usize) -> Option<u8> {
    if begin >= storage.len() { return None; }
    Some(storage[begin])
}

// refines Luffs.Runtime.Containers.boxLoadU16
fn box_load_u16(storage: &[u8], begin: usize) -> Option<u16> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    Some(u16::from_le_bytes([storage[begin], storage[begin + 1]]))
}

// refines Luffs.Runtime.Containers.boxStoreU8
fn box_store_u8(storage: &mut [u8], begin: usize, value: u8) -> Option<()> {
    if begin >= storage.len() { return None; }
    storage[begin] = value;
    Some(())
}

// refines Luffs.Runtime.Containers.boxStoreU16
fn box_store_u16(storage: &mut [u8], begin: usize, value: u16) -> Option<()> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU32
fn box_load_u32(storage: &[u8], begin: usize) -> Option<u32> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    Some(u32::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3]]))
}

// refines Luffs.Runtime.Containers.boxStoreU32
fn box_store_u32(storage: &mut [u8], begin: usize, value: u32) -> Option<()> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU64
fn box_load_u64(storage: &[u8], begin: usize) -> Option<u64> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    Some(u64::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7]]))
}

// refines Luffs.Runtime.Containers.boxStoreU64
fn box_store_u64(storage: &mut [u8], begin: usize, value: u64) -> Option<()> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    Some(())
}

// Signed scalars use the same two's-complement BitVec byte semantics.
// refines Luffs.Runtime.Containers.boxLoadU16
fn box_load_i16(storage: &[u8], begin: usize) -> Option<i16> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    Some(i16::from_le_bytes([storage[begin], storage[begin + 1]]))
}

// refines Luffs.Runtime.Containers.boxStoreU16
fn box_store_i16(storage: &mut [u8], begin: usize, value: i16) -> Option<()> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU32
fn box_load_i32(storage: &[u8], begin: usize) -> Option<i32> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    Some(i32::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3]]))
}

// refines Luffs.Runtime.Containers.boxStoreU32
fn box_store_i32(storage: &mut [u8], begin: usize, value: i32) -> Option<()> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU64
fn box_load_i64(storage: &[u8], begin: usize) -> Option<i64> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    Some(i64::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7]]))
}

// refines Luffs.Runtime.Containers.boxStoreU64
fn box_store_i64(storage: &mut [u8], begin: usize, value: i64) -> Option<()> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    Some(())
}

// The current Luffs target model fixes pointer-sized integers at 64 bits.
// refines Luffs.Runtime.Containers.boxLoadUsize
fn box_load_usize(storage: &[u8], begin: usize) -> Option<usize> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    let word: u64 = u64::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7]]);
    Some(word as usize)
}

// refines Luffs.Runtime.Containers.boxStoreUsize
fn box_store_usize(storage: &mut [u8], begin: usize, value: usize) -> Option<()> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    let word: u64 = value as u64;
    storage[begin] = (word & 255) as u8;
    storage[begin + 1] = (word >> 8) as u8;
    storage[begin + 2] = (word >> 16) as u8;
    storage[begin + 3] = (word >> 24) as u8;
    storage[begin + 4] = (word >> 32) as u8;
    storage[begin + 5] = (word >> 40) as u8;
    storage[begin + 6] = (word >> 48) as u8;
    storage[begin + 7] = (word >> 56) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU64
fn box_load_isize(storage: &[u8], begin: usize) -> Option<isize> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    Some(isize::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7]]))
}

// refines Luffs.Runtime.Containers.boxStoreU64
fn box_store_isize(storage: &mut [u8], begin: usize, value: isize) -> Option<()> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.vecPushU8
fn vec_push_u8(storage: &mut [u8], len: usize, capacity: usize, value: u8) -> Option<usize> {
    if len >= capacity { return None; }
    if capacity > storage.len() { return None; }
    storage[len] = value;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU16
fn vec_push_u16(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u16) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 2 { return None; }
    if offset > usize::MAX - len * 2 { return None; }
    if offset + len * 2 > usize::MAX - 2 { return None; }
    if offset + len * 2 + 1 >= storage.len() { return None; }
    storage[offset + len * 2] = (value & 255) as u8;
    storage[offset + len * 2 + 1] = (value >> 8) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU32
fn vec_push_u32(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u32) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 4 { return None; }
    if offset > usize::MAX - len * 4 { return None; }
    if offset + len * 4 > usize::MAX - 4 { return None; }
    if offset + len * 4 + 3 >= storage.len() { return None; }
    storage[offset + len * 4] = (value & 255) as u8;
    storage[offset + len * 4 + 1] = (value >> 8) as u8;
    storage[offset + len * 4 + 2] = (value >> 16) as u8;
    storage[offset + len * 4 + 3] = (value >> 24) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU64
fn vec_push_u64(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u64) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 8 { return None; }
    if offset > usize::MAX - len * 8 { return None; }
    if offset + len * 8 > usize::MAX - 8 { return None; }
    if offset + len * 8 + 7 >= storage.len() { return None; }
    storage[offset + len * 8] = (value & 255) as u8;
    storage[offset + len * 8 + 1] = (value >> 8) as u8;
    storage[offset + len * 8 + 2] = (value >> 16) as u8;
    storage[offset + len * 8 + 3] = (value >> 24) as u8;
    storage[offset + len * 8 + 4] = (value >> 32) as u8;
    storage[offset + len * 8 + 5] = (value >> 40) as u8;
    storage[offset + len * 8 + 6] = (value >> 48) as u8;
    storage[offset + len * 8 + 7] = (value >> 56) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecLastU8
fn vec_last_u8(storage: &[u8], len: usize) -> Option<u8> {
    if len == 0 { return None; }
    if len > storage.len() { return None; }
    let index: usize = len - 1;
    Some(storage[index])
}

// refines Luffs.Runtime.Containers.vecLenAfterPop
fn vec_len_after_pop(len: usize) -> Option<usize> {
    if len == 0 { return None; }
    let next_len: usize = len - 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecGetU8
fn vec_get_u8(storage: &[u8], len: usize, index: usize) -> Option<u8> {
    if index >= len { return None; }
    if len > storage.len() { return None; }
    Some(storage[index])
}

// refines Luffs.Runtime.Containers.vecGetU16
fn vec_get_u16(storage: &[u8], offset: usize, len: usize, index: usize) -> Option<u16> {
    if index >= len { return None; }
    if index > usize::MAX / 2 { return None; }
    if offset > usize::MAX - index * 2 { return None; }
    if offset + index * 2 > usize::MAX - 2 { return None; }
    if offset + index * 2 + 1 >= storage.len() { return None; }
    Some(u16::from_le_bytes([storage[offset + index * 2], storage[offset + index * 2 + 1]]))
}

// refines Luffs.Runtime.Containers.vecGetU32
fn vec_get_u32(storage: &[u8], offset: usize, len: usize, index: usize) -> Option<u32> {
    if index >= len { return None; }
    if index > usize::MAX / 4 { return None; }
    if offset > usize::MAX - index * 4 { return None; }
    if offset + index * 4 > usize::MAX - 4 { return None; }
    if offset + index * 4 + 3 >= storage.len() { return None; }
    Some(u32::from_le_bytes([storage[offset + index * 4], storage[offset + index * 4 + 1], storage[offset + index * 4 + 2], storage[offset + index * 4 + 3]]))
}

// refines Luffs.Runtime.Containers.vecGetU64
fn vec_get_u64(storage: &[u8], offset: usize, len: usize, index: usize) -> Option<u64> {
    if index >= len { return None; }
    if index > usize::MAX / 8 { return None; }
    if offset > usize::MAX - index * 8 { return None; }
    if offset + index * 8 > usize::MAX - 8 { return None; }
    if offset + index * 8 + 7 >= storage.len() { return None; }
    Some(u64::from_le_bytes([storage[offset + index * 8], storage[offset + index * 8 + 1], storage[offset + index * 8 + 2], storage[offset + index * 8 + 3], storage[offset + index * 8 + 4], storage[offset + index * 8 + 5], storage[offset + index * 8 + 6], storage[offset + index * 8 + 7]]))
}

// refines Luffs.Runtime.Containers.vecSliceU8
fn vec_slice_u8(storage: &[u8], len: usize, begin: usize, end: usize) -> Option<&[u8]> {
    if begin > end { return None; }
    if end > len { return None; }
    if len > storage.len() { return None; }
    Some(storage[begin..<end])
}

// refines Luffs.Runtime.Containers.vecSliceU8
fn vec_slice_mut_u8(storage: &mut [u8], len: usize, begin: usize, end: usize) -> Option<&mut [u8]> {
    if begin > end { return None; }
    if end > len { return None; }
    if len > storage.len() { return None; }
    Some(storage[begin..<end])
}

// refines Luffs.Runtime.Containers.vecCopyGrowU8
fn vec_copy_grow_u8(source: &[u8], destination: &mut [u8], len: usize) -> Option<()> {
    if len > source.len() { return None; }
    if len > destination.len() { return None; }
    let from: &[u8] = source[0..<len];
    let to: &mut [u8] = destination[0..<len];
    to.copy_from_slice(from);
    Some(())
}
