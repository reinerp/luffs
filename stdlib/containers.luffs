// Concrete byte-specialized Box and Vec runtime operations. Generic codecs are
// represented in Lean; these functions are the first monomorphized lowering.

// refines Luffs.Runtime.Containers.boxStoreU8
fn box_initialize_u8(storage: &mut [u8], begin: usize, value: u8) -> Option<()> {
    if begin >= storage.len() { return None; }
    storage[begin] = value;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU8
fn box_load_u8(storage: &[u8], begin: usize) -> Option<u8> {
    if begin >= storage.len() { return None; }
    Some(storage[begin])
}

// refines Luffs.Runtime.Containers.boxLoadU16
fn box_load_u16(storage: &[u8], begin: usize) -> Option<u16> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    Some(u16::from_le_bytes([storage[begin], storage[begin + 1]]))
}

// refines Luffs.Runtime.Containers.boxStoreU8
fn box_store_u8(storage: &mut [u8], begin: usize, value: u8) -> Option<()> {
    if begin >= storage.len() { return None; }
    storage[begin] = value;
    Some(())
}

// refines Luffs.Runtime.Containers.boxStoreU16
fn box_store_u16(storage: &mut [u8], begin: usize, value: u16) -> Option<()> {
    if begin == usize::MAX { return None; }
    if begin + 1 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU32
fn box_load_u32(storage: &[u8], begin: usize) -> Option<u32> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    Some(u32::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3]]))
}

// refines Luffs.Runtime.Containers.boxStoreU32
fn box_store_u32(storage: &mut [u8], begin: usize, value: u32) -> Option<()> {
    if begin > usize::MAX - 3 { return None; }
    if begin + 3 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU64
fn box_load_u64(storage: &[u8], begin: usize) -> Option<u64> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    Some(u64::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7]]))
}

// refines Luffs.Runtime.Containers.boxStoreU64
fn box_store_u64(storage: &mut [u8], begin: usize, value: u64) -> Option<()> {
    if begin > usize::MAX - 7 { return None; }
    if begin + 7 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    Some(())
}

// refines Luffs.Runtime.Containers.boxLoadU128
fn box_load_u128(storage: &[u8], begin: usize) -> Option<u128> {
    if begin > usize::MAX - 15 { return None; }
    if begin + 15 >= storage.len() { return None; }
    Some(u128::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7], storage[begin + 8], storage[begin + 9], storage[begin + 10], storage[begin + 11], storage[begin + 12], storage[begin + 13], storage[begin + 14], storage[begin + 15]]))
}

// refines Luffs.Runtime.Containers.boxStoreU128
fn box_store_u128(storage: &mut [u8], begin: usize, value: u128) -> Option<()> {
    if begin > usize::MAX - 15 { return None; }
    if begin + 15 >= storage.len() { return None; }
    storage[begin] = (value & 255) as u8;
    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    storage[begin + 8] = (value >> 64) as u8;
    storage[begin + 9] = (value >> 72) as u8;
    storage[begin + 10] = (value >> 80) as u8;
    storage[begin + 11] = (value >> 88) as u8;
    storage[begin + 12] = (value >> 96) as u8;
    storage[begin + 13] = (value >> 104) as u8;
    storage[begin + 14] = (value >> 112) as u8;
    storage[begin + 15] = (value >> 120) as u8;
    Some(())
}

// Signed scalars use the same two's-complement BitVec byte semantics.
// refines Luffs.Runtime.Containers.boxLoadI8
fn box_load_i8(storage: &[u8], begin: usize) -> Option<i8> {
    if begin >= storage.len() { return None; }
