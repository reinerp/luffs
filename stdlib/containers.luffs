    storage[begin + 1] = (value >> 8) as u8;
    storage[begin + 2] = (value >> 16) as u8;
    storage[begin + 3] = (value >> 24) as u8;
    storage[begin + 4] = (value >> 32) as u8;
    storage[begin + 5] = (value >> 40) as u8;
    storage[begin + 6] = (value >> 48) as u8;
    storage[begin + 7] = (value >> 56) as u8;
    storage[begin + 8] = (value >> 64) as u8;
    storage[begin + 9] = (value >> 72) as u8;
    storage[begin + 10] = (value >> 80) as u8;
    storage[begin + 11] = (value >> 88) as u8;
    storage[begin + 12] = (value >> 96) as u8;
    storage[begin + 13] = (value >> 104) as u8;
    storage[begin + 14] = (value >> 112) as u8;
    storage[begin + 15] = (value >> 120) as u8;
