// refines Luffs.Runtime.Containers.vecPushU8
fn vec_push_u8(storage: &mut [u8], len: usize, capacity: usize, value: u8) -> Option<usize> {
    if len >= capacity { return None; }
    if capacity > storage.len() { return None; }
    storage[len] = value;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU16
fn vec_push_u16(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u16) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 2 { return None; }
    if offset > usize::MAX - len * 2 { return None; }
    if offset + len * 2 > usize::MAX - 2 { return None; }
    if offset + len * 2 + 1 >= storage.len() { return None; }
    storage[offset + len * 2] = (value & 255) as u8;
    storage[offset + len * 2 + 1] = (value >> 8) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU32
fn vec_push_u32(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u32) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 4 { return None; }
    if offset > usize::MAX - len * 4 { return None; }
    if offset + len * 4 > usize::MAX - 4 { return None; }
    if offset + len * 4 + 3 >= storage.len() { return None; }
    storage[offset + len * 4] = (value & 255) as u8;
    storage[offset + len * 4 + 1] = (value >> 8) as u8;
    storage[offset + len * 4 + 2] = (value >> 16) as u8;
    storage[offset + len * 4 + 3] = (value >> 24) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushU64
fn vec_push_u64(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u64) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 8 { return None; }
    if offset > usize::MAX - len * 8 { return None; }
    if offset + len * 8 > usize::MAX - 8 { return None; }
    if offset + len * 8 + 7 >= storage.len() { return None; }
    storage[offset + len * 8] = (value & 255) as u8;
    storage[offset + len * 8 + 1] = (value >> 8) as u8;
    storage[offset + len * 8 + 2] = (value >> 16) as u8;
    storage[offset + len * 8 + 3] = (value >> 24) as u8;
    storage[offset + len * 8 + 4] = (value >> 32) as u8;
    storage[offset + len * 8 + 5] = (value >> 40) as u8;
    storage[offset + len * 8 + 6] = (value >> 48) as u8;
    storage[offset + len * 8 + 7] = (value >> 56) as u8;
