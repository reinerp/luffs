    if begin + 15 >= storage.len() { return None; }
    Some(i128::from_le_bytes([storage[begin], storage[begin + 1], storage[begin + 2], storage[begin + 3], storage[begin + 4], storage[begin + 5], storage[begin + 6], storage[begin + 7], storage[begin + 8], storage[begin + 9], storage[begin + 10], storage[begin + 11], storage[begin + 12], storage[begin + 13], storage[begin + 14], storage[begin + 15]]))
}

