// refines Luffs.Runtime.Containers.vecPushU128
fn vec_push_u128(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: u128) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 16 { return None; }
    if offset > usize::MAX - len * 16 { return None; }
    if offset + len * 16 > usize::MAX - 16 { return None; }
    if offset + len * 16 + 15 >= storage.len() { return None; }
    storage[offset + len * 16] = (value & 255) as u8;
    storage[offset + len * 16 + 1] = (value >> 8) as u8;
    storage[offset + len * 16 + 2] = (value >> 16) as u8;
    storage[offset + len * 16 + 3] = (value >> 24) as u8;
    storage[offset + len * 16 + 4] = (value >> 32) as u8;
    storage[offset + len * 16 + 5] = (value >> 40) as u8;
    storage[offset + len * 16 + 6] = (value >> 48) as u8;
    storage[offset + len * 16 + 7] = (value >> 56) as u8;
    storage[offset + len * 16 + 8] = (value >> 64) as u8;
    storage[offset + len * 16 + 9] = (value >> 72) as u8;
    storage[offset + len * 16 + 10] = (value >> 80) as u8;
    storage[offset + len * 16 + 11] = (value >> 88) as u8;
    storage[offset + len * 16 + 12] = (value >> 96) as u8;
    storage[offset + len * 16 + 13] = (value >> 104) as u8;
    storage[offset + len * 16 + 14] = (value >> 112) as u8;
    storage[offset + len * 16 + 15] = (value >> 120) as u8;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecPushI128
fn vec_push_i128(storage: &mut [u8], offset: usize, len: usize, capacity: usize, value: i128) -> Option<usize> {
    if len >= capacity { return None; }
    if len > usize::MAX / 16 { return None; }
    if offset > usize::MAX - len * 16 { return None; }
    if offset + len * 16 > usize::MAX - 16 { return None; }
    if offset + len * 16 + 15 >= storage.len() { return None; }
    storage[offset + len * 16] = (value & 255) as u8;
    storage[offset + len * 16 + 1] = (value >> 8) as u8;
    storage[offset + len * 16 + 2] = (value >> 16) as u8;
    storage[offset + len * 16 + 3] = (value >> 24) as u8;
    storage[offset + len * 16 + 4] = (value >> 32) as u8;
    storage[offset + len * 16 + 5] = (value >> 40) as u8;
    storage[offset + len * 16 + 6] = (value >> 48) as u8;
    storage[offset + len * 16 + 7] = (value >> 56) as u8;
    storage[offset + len * 16 + 8] = (value >> 64) as u8;
    storage[offset + len * 16 + 9] = (value >> 72) as u8;
    storage[offset + len * 16 + 10] = (value >> 80) as u8;
    storage[offset + len * 16 + 11] = (value >> 88) as u8;
    storage[offset + len * 16 + 12] = (value >> 96) as u8;
    storage[offset + len * 16 + 13] = (value >> 104) as u8;
