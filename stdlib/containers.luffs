// Codec-generic encoded slice boundary. Callers pass the proved codec size;
// the Lean bridge instantiates this one body for every supported scalar.
// refines Luffs.Runtime.Containers.vecSliceBytes
fn vec_slice_bytes<'a>(storage: &'a [u8], offset: usize, len: usize, begin: usize, end: usize, width: usize) -> Option<&'a [u8]> {
    if begin > end { return None; }
    if end > len { return None; }
    let byte_begin: usize = begin.checked_mul(width)?;
    let byte_end: usize = end.checked_mul(width)?;
    let start: usize = offset.checked_add(byte_begin)?;
    let finish: usize = offset.checked_add(byte_end)?;
    if finish > storage.len() { return None; }
    proof vec_slice_bytes_bounds: start <= finish && finish <= storage.len() by {
        refine ⟨?_, by omega⟩
        subst start
        subst finish
        subst byte_begin
        subst byte_end
        exact Nat.add_le_add_left (Nat.mul_le_mul_right width (show begin <= end_ from by omega)) offset
    }
    Some(storage[start..<finish] by vec_slice_bytes_bounds)
}

// refines Luffs.Runtime.Containers.vecSliceBytes
fn vec_slice_mut_bytes<'a>(storage: &'a mut [u8], offset: usize, len: usize, begin: usize, end: usize, width: usize) -> Option<&'a mut [u8]> {
    if begin > end { return None; }
    if end > len { return None; }
    let byte_begin: usize = begin.checked_mul(width)?;
    let byte_end: usize = end.checked_mul(width)?;
    let start: usize = offset.checked_add(byte_begin)?;
    let finish: usize = offset.checked_add(byte_end)?;
    if finish > storage.len() { return None; }
    proof vec_slice_mut_bytes_bounds: start <= finish && finish <= storage.len() by {
        refine ⟨?_, by omega⟩
        subst start
        subst finish
        subst byte_begin
        subst byte_end
        exact Nat.add_le_add_left (Nat.mul_le_mul_right width (show begin <= end_ from by omega)) offset
    }
    Some(storage[start..<finish] by vec_slice_mut_bytes_bounds)
}

// Native typed slicing is a compiler intrinsic. Its Lean model remains the
// exact object-byte range; vecSlice_native_mut_owns proves alignment, native
// representation, length, and exclusive ownership before this is used as a
// Rust reference.
// refines Luffs.Runtime.Containers.vecSliceU16Bytes
fn vec_slice_u16<'a>(storage: &'a [u8], offset: usize, len: usize, begin: usize, end: usize) -> Option<&'a [u16]> {
    if begin > end { return None; }
    if end > len { return None; }
    if end > usize::MAX / 2 { return None; }
    let byte_begin: usize = begin * 2;
    let byte_end: usize = end * 2;
    if offset > usize::MAX - byte_end { return None; }
    let start: usize = offset + byte_begin;
    let finish: usize = offset + byte_end;
    if finish > storage.len() { return None; }
    Some(native_slice::<u16>(storage[start..<finish]))
}

// refines Luffs.Runtime.Containers.vecSliceU16Bytes
fn vec_slice_mut_u16<'a>(storage: &'a mut [u8], offset: usize, len: usize, begin: usize, end: usize) -> Option<&'a mut [u16]> {
    if begin > end { return None; }
    if end > len { return None; }
    if end > usize::MAX / 2 { return None; }
    let byte_begin: usize = begin * 2;
    let byte_end: usize = end * 2;
    if offset > usize::MAX - byte_end { return None; }
    let start: usize = offset + byte_begin;
    let finish: usize = offset + byte_end;
    if finish > storage.len() { return None; }
    Some(native_slice_mut::<u16>(storage[start..<finish]))
}

// refines Luffs.Runtime.Containers.vecCopyGrowU8
fn vec_copy_grow_u8(source: &[u8], destination: &mut [u8], len: usize) -> Option<()> {
    if len > source.len() { return None; }
    if len > destination.len() { return None; }
    let from: &[u8] = source[0..<len];
    let to: &mut [u8] = destination[0..<len];
    to.copy_from_slice(from);
    Some(())
}
