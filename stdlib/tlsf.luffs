// Fixed-metadata TLSF runtime primitives. The full allocator represents block
// headers as parallel arrays, keeping Luffs' initial aggregate-free subset.
// `next.len()` is the detached/end-of-chain sentinel.

// refines Luffs.Runtime.TLSF.insertArrays
fn tlsf_insert(heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    let old_head: usize = heads[bin];
    next[block] = old_head;
    previous[block] = next.len();
    if old_head < previous.len() {
        previous[old_head] = block;
    }
    heads[bin] = block;
    Some(())
}

// refines Luffs.Runtime.TLSF.removeArrays
fn tlsf_remove(heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    let successor: usize = next[block];
    let predecessor: usize = previous[block];
    if predecessor >= next.len() {
        heads[bin] = successor;
    }
    if predecessor < next.len() {
        next[predecessor] = successor;
    }
    if successor < previous.len() {
        previous[successor] = predecessor;
    }
    next[block] = next.len();
    previous[block] = previous.len();
    Some(())
}

// refines Luffs.Runtime.TLSF.findFit
fn tlsf_find_fit(sizes: &[usize; 4096], is_free: &[u8; 4096], request: usize) -> Option<usize> {
    let mut block: usize = 0;
    while block < sizes.len() {
        if block >= is_free.len() { return None; }
        let free: u8 = is_free[block];
        let bytes: usize = sizes[block];
        if free != 0 {
            if request <= bytes {
                return Some(block);
            }
        }
        if block == usize::MAX { return None; }
        let next_block: usize = block + 1;
        block = next_block;
    }
    None
}

// Search a 256-bit nonempty-bin bitmap at or above `start_bin`. Four machine
// words are examined at most, so this remains a bounded TLSF metadata lookup.
// refines Luffs.Runtime.TLSF.findNonemptyBin
fn tlsf_find_nonempty_bin(nonempty: &[u64; 4], start_bin: usize) -> Option<usize> {
    let mut word: usize = start_bin >> 6;
    let bit = start_bin & 63;
    if word >= nonempty.len() { return None; }

    let first_bitmap: u64 = nonempty[word];
    let first_masked = first_bitmap & (u64::MAX << bit);
    if first_masked != 0 {
        let offset: usize = first_masked.trailing_zeros() as usize;
        if offset >= 64 { return None; }
        let base = word.checked_mul(64)?;
        let bin = base.checked_add(offset)?;
        return Some(bin);
    }

    word = word.checked_add(1)?;
    while word < nonempty.len() {
        let bitmap: u64 = nonempty[word];
        if bitmap != 0 {
            let offset: usize = bitmap.trailing_zeros() as usize;
            if offset >= 64 { return None; }
            let base = word.checked_mul(64)?;
            let bin = base.checked_add(offset)?;
            return Some(bin);
        }
        word = word.checked_add(1)?;
    }
    None
}

// Select and detach the head of the first nonempty bin. If it was the final
// member, clear the corresponding cached bitmap bit. Every fallible bounds
// check precedes tlsf_remove, so failure leaves all metadata unchanged.
// refines Luffs.Runtime.TLSF.takeCandidateArrays
fn tlsf_take_candidate(nonempty: &mut [u64; 4], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], start_bin: usize) -> Option<usize> {
    let bin: usize = tlsf_find_nonempty_bin(nonempty, start_bin)?;
    if bin >= heads.len() { return None; }
    let word: usize = bin >> 6;
    let bit: usize = bin & 63;
    if word >= nonempty.len() { return None; }

    let block: usize = heads[bin];
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }
    let successor: usize = next[block];

    tlsf_remove(heads, next, previous, bin, block)?;
    if successor >= next.len() {
        let bitmap: u64 = nonempty[word];
        let bit_mask: u64 = 1 << bit;
        nonempty[word] = bitmap & !bit_mask;
    }
    Some(block)
}

// True TLSF lookup over the allocator's 64 × 32 class space. Search the
// starting first-level class from start_sl, then use the first-level bitmap to
// jump directly to the next first-level class with a nonempty second level.
// refines Luffs.Runtime.TLSF.findNonemptyClass
fn tlsf_find_nonempty_class(second_nonempty: &[u32; 64], first_nonempty: &[u64; 1], start_fl: usize, start_sl: usize) -> Option<usize> {
    if start_fl >= second_nonempty.len() { return None; }
    if start_sl >= 32 { return None; }
    if first_nonempty.len() == 0 { return None; }

    let second_bitmap: u32 = second_nonempty[start_fl];
    let second_masked: u32 = second_bitmap & (u32::MAX << start_sl);
    if second_masked != 0 {
        let found_sl: usize = second_masked.trailing_zeros() as usize;
        if found_sl >= 32 { return None; }
        let base: usize = start_fl.checked_mul(32)?;
        let bin: usize = base.checked_add(found_sl)?;
        return Some(bin);
    }

    let next_fl: usize = start_fl.checked_add(1)?;
    if next_fl >= 64 { return None; }
    let first_bitmap: u64 = first_nonempty[0];
    let first_masked: u64 = first_bitmap & (u64::MAX << next_fl);
    if first_masked == 0 { return None; }
    let found_fl: usize = first_masked.trailing_zeros() as usize;
    if found_fl >= second_nonempty.len() { return None; }
    let found_second: u32 = second_nonempty[found_fl];
    if found_second == 0 { return None; }
    let found_sl: usize = found_second.trailing_zeros() as usize;
    if found_sl >= 32 { return None; }
    let base: usize = found_fl.checked_mul(32)?;
    let bin: usize = base.checked_add(found_sl)?;
    Some(bin)
}

// Detach the selected class head and update both bitmap levels. The first-level
// bit is cleared exactly when clearing the selected second-level bit empties
// that entire second-level word.
// refines Luffs.Runtime.TLSF.takeCandidateClassArrays
fn tlsf_take_candidate_class(second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], start_fl: usize, start_sl: usize) -> Option<usize> {
    let bin: usize = tlsf_find_nonempty_class(second_nonempty, first_nonempty, start_fl, start_sl)?;
    if bin >= heads.len() { return None; }
    let found_fl: usize = bin >> 5;
    let found_sl: usize = bin & 31;
    if found_fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }

    let block: usize = heads[bin];
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }
    let successor: usize = next[block];

    tlsf_remove(heads, next, previous, bin, block)?;
    if successor >= next.len() {
        let old_second: u32 = second_nonempty[found_fl];
        let second_mask: u32 = 1 << found_sl;
        let new_second: u32 = old_second & !second_mask;
        second_nonempty[found_fl] = new_second;
        if new_second == 0 {
            let old_first: u64 = first_nonempty[0];
            let first_mask: u64 = 1 << found_fl;
            first_nonempty[0] = old_first & !first_mask;
        }
    }
    Some(block)
}

// Restore the allocation-state bit and the following block's boundary tag.
// All possible failure occurs before either write.
// refines Luffs.Runtime.TLSF.markFreeArrays
fn tlsf_mark_free(is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], block: usize) -> Option<()> {
    if block >= is_free.len() { return None; }
    if block >= prev_free.len() { return None; }
    if is_free[block] != 0 { return None; }
    if block == usize::MAX { return None; }
    let successor: usize = block + 1;

    is_free[block] = 1;
    if successor < prev_free.len() {
        prev_free[successor] = 1;
    }
    Some(())
}
