// Fixed-metadata TLSF runtime primitives. The full allocator represents block
// headers as parallel arrays, keeping Luffs' initial aggregate-free subset.
// `next.len()` is the detached/end-of-chain sentinel.

// Map a positive block size down to its 64 × 32 TLSF class, encoded as
// `fl * 32 + sl`. Luffs currently targets 64-bit Rust for allocator metadata.
// refines Luffs.Runtime.TLSF.classifySizeBin
fn tlsf_classify_size(size: usize) -> Option<usize> {
    if size == 0 { return None; }
    if size <= 256 {
        let predecessor: usize = size - 1;
        let sl: usize = predecessor >> 3;
        return Some(sl);
    }

    let leading: usize = size.leading_zeros() as usize;
    if leading > 63 { return None; }
    let fl: usize = 63 - leading;
    if fl < 5 { return None; }
    let base: usize = 1 << fl;
    if base > size { return None; }
    let shift: usize = fl - 5;
    let step: usize = 1 << shift;
    let delta: usize = size - base;
    let sl: usize = delta / step;
    if sl >= 32 { return None; }
    let encoded_base: usize = fl.checked_mul(32)?;
    let encoded: usize = encoded_base.checked_add(sl)?;
    Some(encoded)
}

// Map an allocation request upward to a class whose members can satisfy it.
// This mirrors the proof model's conservative high-bin upper endpoint.
// refines Luffs.Runtime.TLSF.classifyRequestBin
fn tlsf_classify_request(request: usize) -> Option<usize> {
    if request == 0 { return None; }
    if request <= 256 {
        return tlsf_classify_size(request);
    }

    let leading: usize = request.leading_zeros() as usize;
    if leading > 63 { return None; }
    let fl: usize = 63 - leading;
    if fl < 5 { return None; }
    let base: usize = 1 << fl;
    if base > request { return None; }
    let shift: usize = fl - 5;
    let step: usize = 1 << shift;
    let delta: usize = request - base;
    let sl: usize = delta / step;
    if sl >= 32 { return None; }
    let lower_delta: usize = sl.checked_mul(step)?;
    let lower: usize = base.checked_add(lower_delta)?;
    let key: usize = lower.checked_add(step)?;
    tlsf_classify_size(key)
}

// Convert an external address to TLSF's internal pool-relative handle only
// after proving that it lies in the mapped half-open region.
// refines Luffs.Runtime.TLSF.pointerToOffset
fn tlsf_pointer_to_offset(pool_base: usize, pool_bytes: usize, pointer: usize) -> Option<usize> {
    if pointer < pool_base { return None; }
    if pointer - pool_base >= pool_bytes { return None; }
    let offset: usize = pointer - pool_base;
    Some(offset)
}

// refines Luffs.Runtime.TLSF.insertArrays
fn tlsf_insert(heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    let old_head: usize = heads[bin];
    next[block] = old_head;
    previous[block] = next.len();
    if old_head < previous.len() {
        previous[old_head] = block;
    }
    heads[bin] = block;
    Some(())
}

// Insert a free header and set both levels of the nonempty-class cache.
// Every fallible check precedes the intrusive-list mutation.
// refines Luffs.Runtime.TLSF.insertClassArrays
fn tlsf_insert_class(second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    let fl: usize = bin >> 5;
    let sl: usize = bin & 31;
    if fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    tlsf_insert(heads, next, previous, bin, block)?;
    let second_mask: u32 = 1 << sl;
    second_nonempty[fl] = second_nonempty[fl] | second_mask;
    let first_mask: u64 = 1 << fl;
    first_nonempty[0] = first_nonempty[0] | first_mask;
    Some(())
}

// Initialize all fixed metadata for one freshly mmap-backed pool. The mmap
// itself is the trusted platform boundary; this function constructs and bins
// the allocator's single initial free block.
// refines Luffs.Runtime.TLSF.initializeArrays
fn tlsf_initialize(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], pool_bytes: usize) -> Option<usize> {
    if offsets.len() == 0 { return None; }
    if sizes.len() != offsets.len() { return None; }
    if is_free.len() != offsets.len() { return None; }
    if prev_free.len() != offsets.len() { return None; }
    if next.len() != offsets.len() { return None; }
    if previous.len() != offsets.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    // Free-list links are indexed by byte offset in this bounded-pool
    // implementation, so every pool offset must fit the link arrays.
    if pool_bytes > next.len() { return None; }
    let bin: usize = tlsf_classify_size(pool_bytes)?;
    let sentinel: usize = next.len();

    let mut cursor: usize = 0;
    while cursor < offsets.len() {
        offsets[cursor] = 0;
        sizes[cursor] = 0;
        is_free[cursor] = 0;
        prev_free[cursor] = 0;
        next[cursor] = sentinel;
        previous[cursor] = sentinel;
        cursor = cursor + 1;
    }

    let mut word: usize = 0;
    while word < second_nonempty.len() {
        second_nonempty[word] = 0;
        word = word + 1;
    }
    first_nonempty[0] = 0;

    let mut class_index: usize = 0;
    while class_index < heads.len() {
        heads[class_index] = sentinel;
        class_index = class_index + 1;
    }

    offsets[0] = 0;
    sizes[0] = pool_bytes;
    is_free[0] = 1;
    prev_free[0] = 0;
    tlsf_insert_class(second_nonempty, first_nonempty, heads, next, previous, bin, 0)?;
    Some(1)
}

// refines Luffs.Runtime.TLSF.removeArrays
fn tlsf_remove(heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    let successor: usize = next[block];
    let predecessor: usize = previous[block];
    if predecessor >= next.len() {
        heads[bin] = successor;
    }
    if predecessor < next.len() {
        next[predecessor] = successor;
    }
    if successor < previous.len() {
        previous[successor] = predecessor;
    }
    next[block] = next.len();
    previous[block] = previous.len();
    Some(())
}

// Detach a known node from its size class and update both bitmap levels. The
// node may occur anywhere in the intrusive chain, unlike candidate selection.
// refines Luffs.Runtime.TLSF.removeClassArrays
fn tlsf_remove_class(second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], bin: usize, block: usize) -> Option<()> {
    if bin >= heads.len() { return None; }
    let fl: usize = bin >> 5;
    let sl: usize = bin & 31;
    if fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }

    let successor: usize = next[block];
    let predecessor: usize = previous[block];
    tlsf_remove(heads, next, previous, bin, block)?;
    if predecessor >= next.len() && successor >= next.len() {
        let old_second: u32 = second_nonempty[fl];
        let second_mask: u32 = 1 << sl;
        let new_second: u32 = old_second & !second_mask;
        second_nonempty[fl] = new_second;
        if new_second == 0 {
            let old_first: u64 = first_nonempty[0];
            let first_mask: u64 = 1 << fl;
            first_nonempty[0] = old_first & !first_mask;
        }
    }
    Some(())
}

// refines Luffs.Runtime.TLSF.findFit
fn tlsf_find_fit(sizes: &[usize; 4096], is_free: &[u8; 4096], request: usize) -> Option<usize> {
    let mut block: usize = 0;
    while block < sizes.len() {
        if block >= is_free.len() { return None; }
        let free: u8 = is_free[block];
        let bytes: usize = sizes[block];
        if free != 0 {
            if request <= bytes {
                return Some(block);
            }
        }
        if block == usize::MAX { return None; }
        let next_block: usize = block + 1;
        block = next_block;
    }
    None
}

// Search a 256-bit nonempty-bin bitmap at or above `start_bin`. Four machine
// words are examined at most, so this remains a bounded TLSF metadata lookup.
// refines Luffs.Runtime.TLSF.findNonemptyBin
fn tlsf_find_nonempty_bin(nonempty: &[u64; 4], start_bin: usize) -> Option<usize> {
    let mut word: usize = start_bin >> 6;
    let bit = start_bin & 63;
    if word >= nonempty.len() { return None; }

    let first_bitmap: u64 = nonempty[word];
    let first_masked = first_bitmap & (u64::MAX << bit);
    if first_masked != 0 {
        let offset: usize = first_masked.trailing_zeros() as usize;
        if offset >= 64 { return None; }
        let base = word.checked_mul(64)?;
        let bin = base.checked_add(offset)?;
        return Some(bin);
    }

    word = word.checked_add(1)?;
    while word < nonempty.len() {
        let bitmap: u64 = nonempty[word];
        if bitmap != 0 {
            let offset: usize = bitmap.trailing_zeros() as usize;
            if offset >= 64 { return None; }
            let base = word.checked_mul(64)?;
            let bin = base.checked_add(offset)?;
            return Some(bin);
        }
        word = word.checked_add(1)?;
    }
    None
}

// Select and detach the head of the first nonempty bin. If it was the final
// member, clear the corresponding cached bitmap bit. Every fallible bounds
// check precedes tlsf_remove, so failure leaves all metadata unchanged.
// refines Luffs.Runtime.TLSF.takeCandidateArrays
fn tlsf_take_candidate(nonempty: &mut [u64; 4], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], start_bin: usize) -> Option<usize> {
    let bin: usize = tlsf_find_nonempty_bin(nonempty, start_bin)?;
    if bin >= heads.len() { return None; }
    let word: usize = bin >> 6;
    let bit: usize = bin & 63;
    if word >= nonempty.len() { return None; }

    let block: usize = heads[bin];
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }
    let successor: usize = next[block];

    tlsf_remove(heads, next, previous, bin, block)?;
    if successor >= next.len() {
        let bitmap: u64 = nonempty[word];
        let bit_mask: u64 = 1 << bit;
        nonempty[word] = bitmap & !bit_mask;
    }
    Some(block)
}

// True TLSF lookup over the allocator's 64 × 32 class space. Search the
// starting first-level class from start_sl, then use the first-level bitmap to
// jump directly to the next first-level class with a nonempty second level.
// refines Luffs.Runtime.TLSF.findNonemptyClass
fn tlsf_find_nonempty_class(second_nonempty: &[u32; 64], first_nonempty: &[u64; 1], start_fl: usize, start_sl: usize) -> Option<usize> {
    if start_fl >= second_nonempty.len() { return None; }
    if start_sl >= 32 { return None; }
    if first_nonempty.len() == 0 { return None; }

    let second_bitmap: u32 = second_nonempty[start_fl];
    let second_masked: u32 = second_bitmap & (u32::MAX << start_sl);
    if second_masked != 0 {
        let found_sl: usize = second_masked.trailing_zeros() as usize;
        if found_sl >= 32 { return None; }
        let base: usize = start_fl.checked_mul(32)?;
        let bin: usize = base.checked_add(found_sl)?;
        return Some(bin);
    }

    let next_fl: usize = start_fl.checked_add(1)?;
    if next_fl >= 64 { return None; }
    let first_bitmap: u64 = first_nonempty[0];
    let first_masked: u64 = first_bitmap & (u64::MAX << next_fl);
    if first_masked == 0 { return None; }
    let found_fl: usize = first_masked.trailing_zeros() as usize;
    if found_fl >= second_nonempty.len() { return None; }
    let found_second: u32 = second_nonempty[found_fl];
    if found_second == 0 { return None; }
    let found_sl: usize = found_second.trailing_zeros() as usize;
    if found_sl >= 32 { return None; }
    let base: usize = found_fl.checked_mul(32)?;
    let bin: usize = base.checked_add(found_sl)?;
    Some(bin)
}

// Detach the selected class head and update both bitmap levels. The first-level
// bit is cleared exactly when clearing the selected second-level bit empties
// that entire second-level word.
// refines Luffs.Runtime.TLSF.takeCandidateClassArrays
fn tlsf_take_candidate_class(second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], start_fl: usize, start_sl: usize) -> Option<usize> {
    let bin: usize = tlsf_find_nonempty_class(second_nonempty, first_nonempty, start_fl, start_sl)?;
    if bin >= heads.len() { return None; }
    let found_fl: usize = bin >> 5;
    let found_sl: usize = bin & 31;
    if found_fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }

    let block: usize = heads[bin];
    if block >= next.len() { return None; }
    if block >= previous.len() { return None; }
    let successor: usize = next[block];

    tlsf_remove(heads, next, previous, bin, block)?;
    if successor >= next.len() {
        let old_second: u32 = second_nonempty[found_fl];
        let second_mask: u32 = 1 << found_sl;
        let new_second: u32 = old_second & !second_mask;
        second_nonempty[found_fl] = new_second;
        if new_second == 0 {
            let old_first: u64 = first_nonempty[0];
            let first_mask: u64 = 1 << found_fl;
            first_nonempty[0] = old_first & !first_mask;
        }
    }
    Some(block)
}

// Perform only the selected physical-header mutation. Bin removal and
// remainder insertion are separate verified stages.
// refines Luffs.Runtime.TLSF.allocatePhysicalArrays
fn tlsf_allocate_physical(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], block_count: &mut [usize; 1], block: usize, request: usize) -> Option<usize> {
    if request == 0 { return None; }
    if request & 7 != 0 { return None; }
    if block_count.len() == 0 { return None; }
    let count: usize = block_count[0];
    if count == 0 { return None; }
    if count > offsets.len() { return None; }
    if count > sizes.len() { return None; }
    if count > is_free.len() { return None; }
    if count > prev_free.len() { return None; }

    if block >= count { return None; }
    if is_free[block] == 0 { return None; }
    let selected_offset: usize = offsets[block];
    let selected_size: usize = sizes[block];
    if selected_size < request { return None; }
    let remainder_size: usize = selected_size - request;
    let split: bool = remainder_size >= 16;
    let mut remainder_offset: usize = 0;
    if split {
        if count >= offsets.len() { return None; }
        if count >= sizes.len() { return None; }
        if count >= is_free.len() { return None; }
        if count >= prev_free.len() { return None; }
        remainder_offset = selected_offset.checked_add(request)?;
        let successor: usize = block.checked_add(1)?;
        let mut cursor: usize = count;
        while cursor > successor {
            if cursor > count { return None; }
            let prior: usize = cursor - 1;
            offsets[cursor] = offsets[prior];
            sizes[cursor] = sizes[prior];
            is_free[cursor] = is_free[prior];
            prev_free[cursor] = prev_free[prior];
            cursor = prior;
        }
        sizes[block] = request;
        is_free[block] = 0;
        offsets[block + 1] = remainder_offset;
        sizes[block + 1] = remainder_size;
        is_free[block + 1] = 1;
        prev_free[block + 1] = 0;
        let after_remainder: usize = successor.checked_add(1)?;
        if after_remainder < count + 1 {
            prev_free[after_remainder] = 1;
        }
        block_count[0] = count + 1;
    } else {
        is_free[block] = 0;
        let successor: usize = block.checked_add(1)?;
        if successor < count {
            prev_free[successor] = 0;
        }
    }
    Some(selected_offset)
}

// Allocate one aligned region. All checks precede the first write, so failure
// is transactional. The returned value is the byte offset within the mmap
// pool; `block_count[0]` carries the active physical-header count.
// refines Luffs.Runtime.TLSF.allocateArrays
fn tlsf_allocate(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], request: usize) -> Option<usize> {
    if request == 0 { return None; }
    if request & 7 != 0 { return None; }
    let start_bin: usize = tlsf_classify_request(request)?;
    let start_fl: usize = start_bin >> 5;
    let start_sl: usize = start_bin & 31;
    let found_bin: usize = tlsf_find_nonempty_class(second_nonempty, first_nonempty, start_fl, start_sl)?;
    if found_bin >= heads.len() { return None; }
    let found_fl: usize = found_bin >> 5;
    if found_fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    let selected_offset: usize = heads[found_bin];
    if selected_offset >= next.len() { return None; }
    if selected_offset >= previous.len() { return None; }
    if block_count.len() == 0 { return None; }
    let count: usize = block_count[0];
    if count == 0 { return None; }
    if count > offsets.len() { return None; }
    if count > sizes.len() { return None; }
    if count > is_free.len() { return None; }
    if count > prev_free.len() { return None; }
    let mut block: usize = 0;
    while block < count {
        if offsets[block] == selected_offset { break; }
        if block == usize::MAX { return None; }
        block = block + 1;
    }
    if block >= count { return None; }
    if is_free[block] == 0 { return None; }
    let selected_size: usize = sizes[block];
    if selected_size < request { return None; }
    let remainder_size: usize = selected_size - request;
    let split: bool = remainder_size >= 16;
    let mut remainder_offset: usize = 0;
    let mut remainder_bin: usize = 0;
    if split {
        if count >= offsets.len() { return None; }
        if count >= sizes.len() { return None; }
        if count >= is_free.len() { return None; }
        if count >= prev_free.len() { return None; }
        remainder_offset = selected_offset.checked_add(request)?;
        if remainder_offset >= next.len() { return None; }
        if remainder_offset >= previous.len() { return None; }
        remainder_bin = tlsf_classify_size(remainder_size)?;
        if remainder_bin >= heads.len() { return None; }
        let remainder_fl: usize = remainder_bin >> 5;
        if remainder_fl >= second_nonempty.len() { return None; }
    }
    let detached_offset: usize = tlsf_take_candidate_class(second_nonempty, first_nonempty, heads, next, previous, start_fl, start_sl)?;
    let allocated_offset: usize = tlsf_allocate_physical(offsets, sizes, is_free, prev_free, block_count, block, request)?;
    if split {
        tlsf_insert_class(second_nonempty, first_nonempty, heads, next, previous, remainder_bin, remainder_offset)?;
    }
    Some(allocated_offset)
}

// Restore the allocation-state bit and the following block's boundary tag.
// All possible failure occurs before either write.
// refines Luffs.Runtime.TLSF.markFreeArrays
fn tlsf_mark_free(offsets: &[usize; 4096], sizes: &[usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], block: usize, returned_offset: usize, returned_bytes: usize) -> Option<()> {
    if block >= offsets.len() { return None; }
    if block >= sizes.len() { return None; }
    if block >= is_free.len() { return None; }
    if block >= prev_free.len() { return None; }
    if is_free[block] != 0 { return None; }
    if offsets[block] != returned_offset { return None; }
    if sizes[block] != returned_bytes { return None; }
    if block == usize::MAX { return None; }
    let successor: usize = block + 1;

    is_free[block] = 1;
    if successor < prev_free.len() {
        prev_free[successor] = 1;
    }
    Some(())
}

// Atomically validate and perform the uncoalesced half of deallocation.
// `block` is a physical-header array index; free-list links use byte offsets.
// Every fallible condition is checked before tlsf_mark_free performs a write.
// refines Luffs.Runtime.TLSF.deallocateUncoalescedArrays
fn tlsf_deallocate_uncoalesced(offsets: &[usize; 4096], sizes: &[usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: usize, block: usize, returned_offset: usize, returned_bytes: usize) -> Option<()> {
    if block_count > offsets.len() { return None; }
    if block_count > sizes.len() { return None; }
    if block_count > is_free.len() { return None; }
    if block_count > prev_free.len() { return None; }
    if block >= block_count { return None; }
    if block >= offsets.len() { return None; }
    if block >= sizes.len() { return None; }
    if block >= is_free.len() { return None; }
    if block >= prev_free.len() { return None; }
    if is_free[block] != 0 { return None; }
    if offsets[block] != returned_offset { return None; }
    if sizes[block] != returned_bytes { return None; }
    if block == usize::MAX { return None; }

    let bin: usize = tlsf_classify_size(returned_bytes)?;
    if bin >= heads.len() { return None; }
    let fl: usize = bin >> 5;
    if fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    if returned_offset >= next.len() { return None; }
    if returned_offset >= previous.len() { return None; }

    tlsf_mark_free(offsets, sizes, is_free, prev_free, block, returned_offset, returned_bytes)?;
    tlsf_insert_class(second_nonempty, first_nonempty, heads, next, previous, bin, returned_offset)?;
    Some(())
}

// Merge adjacent free physical headers and compact the active prefix.
// All checks, including both arithmetic operations, precede the first write.
// refines Luffs.Runtime.TLSF.coalescePhysicalArrays
fn tlsf_coalesce_physical(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], block_count: usize, left: usize) -> Option<usize> {
    if block_count > offsets.len() { return None; }
    if block_count > sizes.len() { return None; }
    if block_count > is_free.len() { return None; }
    if block_count > prev_free.len() { return None; }
    if left == usize::MAX { return None; }
    let right: usize = left + 1;
    if right >= block_count { return None; }
    if is_free[left] == 0 { return None; }
    if is_free[right] == 0 { return None; }
    let left_end: usize = offsets[left].checked_add(sizes[left])?;
    if left_end != offsets[right] { return None; }
    let merged_size: usize = sizes[left].checked_add(sizes[right])?;

    sizes[left] = merged_size;
    let mut cursor: usize = right;
    while cursor < block_count - 1 {
        let source: usize = cursor + 1;
        offsets[cursor] = offsets[source];
        sizes[cursor] = sizes[source];
        is_free[cursor] = is_free[source];
        prev_free[cursor] = prev_free[source];
        cursor = source;
    }
    Some(block_count - 1)
}

// Atomically detach an adjacent free pair from its old classes, compact its
// physical headers, and insert the merged header into its new class. Every
// fallible condition is checked before the first metadata write.
// refines Luffs.Runtime.TLSF.coalesceClassArrays
fn tlsf_coalesce_class(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: usize, left: usize) -> Option<usize> {
    if block_count > offsets.len() { return None; }
    if block_count > sizes.len() { return None; }
    if block_count > is_free.len() { return None; }
    if block_count > prev_free.len() { return None; }
    if left == usize::MAX { return None; }
    let right: usize = left + 1;
    if right >= block_count { return None; }
    if is_free[left] == 0 { return None; }
    if is_free[right] == 0 { return None; }

    let left_offset: usize = offsets[left];
    let right_offset: usize = offsets[right];
    let left_size: usize = sizes[left];
    let right_size: usize = sizes[right];
    let left_end: usize = left_offset.checked_add(left_size)?;
    if left_end != right_offset { return None; }
    let merged_size: usize = left_size.checked_add(right_size)?;
    let left_bin: usize = tlsf_classify_size(left_size)?;
    let right_bin: usize = tlsf_classify_size(right_size)?;
    let merged_bin: usize = tlsf_classify_size(merged_size)?;

    if left_bin >= heads.len() { return None; }
    if right_bin >= heads.len() { return None; }
    if merged_bin >= heads.len() { return None; }
    let left_fl: usize = left_bin >> 5;
    let right_fl: usize = right_bin >> 5;
    let merged_fl: usize = merged_bin >> 5;
    if left_fl >= second_nonempty.len() { return None; }
    if right_fl >= second_nonempty.len() { return None; }
    if merged_fl >= second_nonempty.len() { return None; }
    if first_nonempty.len() == 0 { return None; }
    if left_offset >= next.len() { return None; }
    if left_offset >= previous.len() { return None; }
    if right_offset >= next.len() { return None; }
    if right_offset >= previous.len() { return None; }

    tlsf_remove_class(second_nonempty, first_nonempty, heads, next, previous, left_bin, left_offset)?;
    tlsf_remove_class(second_nonempty, first_nonempty, heads, next, previous, right_bin, right_offset)?;
    let new_count: usize = tlsf_coalesce_physical(offsets, sizes, is_free, prev_free, block_count, left)?;
    tlsf_insert_class(second_nonempty, first_nonempty, heads, next, previous, merged_bin, left_offset)?;
    Some(new_count)
}

// Coalesce `left` with its right neighbor exactly when the physical metadata
// says that the pair is adjacent and free. A missing or ineligible neighbor is
// a successful no-op, matching the abstract `coalesceIfPossible` transition.
// refines Luffs.Runtime.TLSF.coalesceIfPossibleArrays
fn tlsf_coalesce_if_possible(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: usize, left: usize) -> Option<usize> {
    if block_count > offsets.len() { return None; }
    if block_count > sizes.len() { return None; }
    if block_count > is_free.len() { return None; }
    if block_count > prev_free.len() { return None; }
    if left == usize::MAX { return Some(block_count); }
    let right: usize = left + 1;
    if right >= block_count { return Some(block_count); }
    if is_free[left] == 0 { return Some(block_count); }
    if is_free[right] == 0 { return Some(block_count); }
    let left_end: usize = offsets[left].checked_add(sizes[left])?;
    if left_end != offsets[right] { return Some(block_count); }
    tlsf_coalesce_class(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, left)
}

// Public sequential deallocation: validate and restore the returned block,
// then merge first with its right neighbor and then with its left neighbor.
// refines Luffs.Runtime.TLSF.deallocateArrays
fn tlsf_deallocate(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: usize, block: usize, returned_offset: usize, returned_bytes: usize) -> Option<usize> {
    tlsf_deallocate_uncoalesced(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, block, returned_offset, returned_bytes)?;
    let after_right: usize = tlsf_coalesce_if_possible(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, block)?;
    if block == 0 { return Some(after_right); }
    let left: usize = block - 1;
    tlsf_coalesce_if_possible(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, after_right, left)
}

// Byte-monomorphized allocator-backed Box. Until Luffs gains structs, the
// handle is the allocation's byte offset within `pool`; TLSF retains its size.
// refines Luffs.Runtime.Containers.boxNewU8Arrays
fn tlsf_box_new_u8(pool: &mut [u8; 4096], offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], value: u8) -> Option<usize> {
    let offset: usize = tlsf_allocate(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, 8)?;
    if offset >= pool.len() { return None; }
    pool[offset] = value;
    Some(offset)
}

// refines Luffs.Runtime.Containers.boxNewU16Arrays
fn tlsf_box_new_u16(pool: &mut [u8; 4096], offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], value: u16) -> Option<usize> {
    let offset: usize = tlsf_allocate(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, 8)?;
    let end: usize = offset.checked_add(2)?;
    if end > pool.len() { return None; }
    pool[offset] = value as u8;
    let high: usize = offset + 1;
    pool[high] = (value >> 8) as u8;
    Some(offset)
}

// refines Luffs.Runtime.Containers.boxLoadU8
fn tlsf_box_load_u8(pool: &[u8; 4096], offset: usize) -> Option<u8> {
    if offset >= pool.len() { return None; }
    Some(pool[offset])
}

// refines Luffs.Runtime.Containers.boxStoreU8
fn tlsf_box_store_u8(pool: &mut [u8; 4096], offset: usize, value: u8) -> Option<()> {
    if offset >= pool.len() { return None; }
    pool[offset] = value;
    Some(())
}

// refines Luffs.Runtime.Containers.boxDropU8Arrays
fn tlsf_box_drop_u8(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], returned_offset: usize) -> Option<()> {
    if block_count.len() == 0 { return None; }
    let count: usize = block_count[0];
    if count == 0 { return None; }
    if count > offsets.len() { return None; }
    if count > sizes.len() { return None; }
    if count > is_free.len() { return None; }
    let mut block: usize = 0;
    while block < count {
        if offsets[block] == returned_offset { break; }
        if block == usize::MAX { return None; }
        block = block + 1;
    }
    if block >= count { return None; }
    if is_free[block] != 0 { return None; }
    let returned_bytes: usize = sizes[block];
    let next_count: usize = tlsf_deallocate(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, count, block, returned_offset, returned_bytes)?;
    block_count[0] = next_count;
    Some(())
}

// Public pointer-facing Box drop. TLSF itself receives only a validated
// pool-relative offset.
// refines Luffs.Runtime.Containers.boxDropPointerU8Arrays
fn tlsf_box_drop_ptr_u8(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], pool_base: usize, pool_bytes: usize, pointer: usize) -> Option<()> {
    let offset: usize = tlsf_pointer_to_offset(pool_base, pool_bytes, pointer)?;
    tlsf_box_drop_u8(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, offset)
}

// Allocator-backed byte vector. The handle is represented by the three scalar
// fields `(offset, len, capacity)` at Luffs call sites.
// refines Luffs.Runtime.Containers.vecNewU8Arrays
fn tlsf_vec_new_u8(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], capacity: usize) -> Option<usize> {
    if capacity == 0 { return None; }
    if capacity > usize::MAX - 7 { return None; }
    let rounded: usize = capacity + 7;
    let request: usize = rounded & !7;
    tlsf_allocate(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, request)
}

// refines Luffs.Runtime.Containers.vecPushU8Offset
fn tlsf_vec_push_u8(pool: &mut [u8; 4096], offset: usize, len: usize, capacity: usize, value: u8) -> Option<usize> {
    if len >= capacity { return None; }
    let index: usize = offset.checked_add(len)?;
    if index >= pool.len() { return None; }
    pool[index] = value;
    let next_len: usize = len + 1;
    Some(next_len)
}

// refines Luffs.Runtime.Containers.vecGetU8Offset
fn tlsf_vec_get_u8(pool: &[u8; 4096], offset: usize, len: usize, index: usize) -> Option<u8> {
    if index >= len { return None; }
    let address: usize = offset.checked_add(index)?;
    if address >= pool.len() { return None; }
    Some(pool[address])
}

// refines Luffs.Runtime.Containers.vecLenAfterPop
fn tlsf_vec_pop_u8(len: usize) -> Option<usize> {
    if len == 0 { return None; }
    Some(len - 1)
}

// refines Luffs.Runtime.Containers.boxDropU8Arrays
fn tlsf_vec_drop_u8(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], offset: usize) -> Option<()> {
    tlsf_box_drop_u8(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, offset)
}

// Public pointer-facing Vec drop.
// refines Luffs.Runtime.Containers.boxDropPointerU8Arrays
fn tlsf_vec_drop_ptr_u8(offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], pool_base: usize, pool_bytes: usize, pointer: usize) -> Option<()> {
    tlsf_box_drop_ptr_u8(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, pool_base, pool_bytes, pointer)
}

// refines Luffs.Runtime.Containers.vecGrowU8Arrays
fn tlsf_vec_grow_u8(pool: &mut [u8; 4096], offsets: &mut [usize; 4096], sizes: &mut [usize; 4096], is_free: &mut [u8; 4096], prev_free: &mut [u8; 4096], second_nonempty: &mut [u32; 64], first_nonempty: &mut [u64; 1], heads: &mut [usize; 2048], next: &mut [usize; 4096], previous: &mut [usize; 4096], block_count: &mut [usize; 1], old_offset: usize, len: usize, old_capacity: usize, new_capacity: usize) -> Option<usize> {
    if len > old_capacity { return None; }
    if new_capacity <= old_capacity { return None; }
    if new_capacity > usize::MAX - 7 { return None; }
    let old_end: usize = old_offset.checked_add(len)?;
    if old_end > pool.len() { return None; }
    let rounded: usize = new_capacity + 7;
    let request: usize = rounded & !7;
    let new_offset: usize = tlsf_allocate(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, request)?;
    let new_end: usize = new_offset.checked_add(len)?;
    if new_end > pool.len() { return None; }
    let mut cursor: usize = 0;
    while cursor < len {
        let source: usize = old_offset.checked_add(cursor)?;
        if source >= pool.len() { return None; }
        let destination: usize = new_offset.checked_add(cursor)?;
        if destination >= pool.len() { return None; }
        let byte: u8 = pool[source];
        pool[destination] = byte;
        cursor = cursor + 1;
    }
    tlsf_box_drop_u8(offsets, sizes, is_free, prev_free, second_nonempty, first_nonempty, heads, next, previous, block_count, old_offset)?;
    Some(new_offset)
}
